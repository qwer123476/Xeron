PVPTab:CreateToggle({
   Name = "킬 오토팡 (TP 펀치)",
   CurrentValue = false,
   Flag = "KillAutoBangToggle",
   Callback = function(Value)
      KillAutoBangEnabled = Value
      if KillAutoBangEnabled then
         CentralEvent:FireServer("SetPVPState", true)
         task.spawn(function()
            local notifiedNoTarget = false
            while KillAutoBangEnabled do
               local target = GetPvpTarget()
               if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                  notifiedNoTarget = false
                  local targetHRP = target.Character.HumanoidRootPart
                  local myChar = LocalPlayer.Character
                  if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                     local myHRP = myChar.HumanoidRootPart
                     myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 5)
                     myHRP.AssemblyLinearVelocity = Vector3.zero
                     CentralEvent:FireServer("PunchRequest", 22)
                  end
               else
                  if not notifiedNoTarget then
                     Rayfield:Notify({
                        Title = "PVP 대상 없음",
                        Content = "PVP 상태인 유저가 존재하지 않습니다. 대기 중...",
                        Duration = 3,
                        Image = 4483362458,
                     })
                     notifiedNoTarget = true
                  end
               end
               RunService.RenderStepped:Wait()
            end
         end)
      end
   end,
})
