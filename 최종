ESPTab:AddToggle({ Name = "벌고있는 돈 표시", Default = false, Callback = function(Value) ESPConfig.Money = Value end })

local ESPObjects = {}

local function CreateESP(player)
    if ESPObjects[player] then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = ESPConfig.Color
    box.Thickness = 1.5
    box.Filled = false

    local text = Drawing.new("Text")
    text.Visible = false
    text.Center = true
    text.Outline = true
    text.Color = ESPConfig.Color
    text.Size = 15

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.FillColor = ESPConfig.Color
    highlight.OutlineColor = ESPConfig.Color

    ESPObjects[player] = { Box = box, Text = text, Highlight = highlight }
end

local function RemoveESP(player)
    if ESPObjects[player] then
        ESPObjects[player].Box:Remove()
        ESPObjects[player].Text:Remove()
        if ESPObjects[player].Highlight.Parent then
            ESPObjects[player].Highlight:Destroy()
        end
        ESPObjects[player] = nil
    end
end

for _, v in pairs(Players:GetPlayers()) do
    if v ~= LocalPlayer then CreateESP(v) end
end
Players.PlayerAdded:Connect(function(v)
    if v ~= LocalPlayer then CreateESP(v) end
end)
Players.PlayerRemoving:Connect(function(v)
    RemoveESP(v)
end)

RunService.RenderStepped:Connect(function()
    local Camera = workspace.CurrentCamera
    for player, esp in pairs(ESPObjects) do
        esp.Box.Color = ESPConfig.Color
        esp.Text.Color = ESPConfig.Color
        esp.Highlight.FillColor = ESPConfig.Color
        esp.Highlight.OutlineColor = ESPConfig.Color

        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            local hrp = char.HumanoidRootPart
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local depth = pos.Z
                local size = Vector2.new(3000 / depth, 4500 / depth)
                local boxPos = Vector2.new(pos.X - size.X / 2, pos.Y - size.Y / 2)
                
                esp.Box.Size = size
                esp.Box.Position = boxPos
                esp.Box.Visible = ESPConfig.Box

                local info = {}
                if ESPConfig.Name then table.insert(info, player.Name) end
                
                if ESPConfig.PvP then
                    if IsPvpActive(player) then table.insert(info, "[PvP: ON]") else table.insert(info, "[PvP: OFF]") end
                end
                
                if ESPConfig.Weapon then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then table.insert(info, "[무기: " .. tool.Name .. "]") else table.insert(info, "[무기: 없음]") end
                end
                
                if ESPConfig.Money then
                    local moneyStr = "0"
                    if player:FindFirstChild("leaderstats") then
                        for _, stat in ipairs(player.leaderstats:GetChildren()) do
                            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                                moneyStr = tostring(stat.Value)
                                break
                            end
                        end
                    end
                    table.insert(info, "[돈: " .. moneyStr .. "]")
                end

                if #info > 0 then
                    esp.Text.Text = table.concat(info, "\n")
                    esp.Text.Position = Vector2.new(pos.X, boxPos.Y - (#info * 16) - 5)
                    esp.Text.Visible = true
                else
                    esp.Text.Visible = false
                end

                if ESPConfig.General then
                    if esp.Highlight.Parent ~= char then esp.Highlight.Parent = char end
                    esp.Highlight.Enabled = true
                else
                    esp.Highlight.Enabled = false
                end
            else
                esp.Box.Visible = false
                esp.Text.Visible = false
                esp.Highlight.Enabled = false
            end
        else
            esp.Box.Visible = false
            esp.Text.Visible = false
            esp.Highlight.Enabled = false
        end
    end
end)

