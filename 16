local SelectedWeapon = ""
local AttackDelay = 0.1
local AutoAttackEnabled = false

local function resetAttributesAndValues(obj)
    if not obj then return end
    
    if obj:IsA("NumberValue") or obj:IsA("IntValue") or obj:IsA("DoubleConstrainedValue") then
        local nameLower = obj.Name:lower()
        if nameLower:find("cooldown") or nameLower:find("cd") or nameLower:find("delay") or nameLower:find("time") or nameLower:find("wait") then
            obj.Value = 0
        end
    elseif obj:IsA("TextLabel") or obj:IsA("TextBox") then
        if obj.Text:find("쿨타임") or obj.Text:find("Cooldown") then
            obj.Text = "쿨타임: 0초"
        end
    end

    local attributes = obj:GetAttributes()
    for attrName, attrVal in pairs(attributes) do
        local nameLower = attrName:lower()
        if nameLower:find("cooldown") or nameLower:find("cd") or nameLower:find("delay") or nameLower:find("time") or nameLower:find("lastattack") or nameLower:find("lastuse") then
            if type(attrVal) == "number" then
                obj:SetAttribute(attrName, 0)
            elseif type(attrVal) == "boolean" then
                obj:SetAttribute(attrName, false)
            end
        end
    end
end

local function wipeCooldowns(instance)
    if not instance then return end
    resetAttributesAndValues(instance)
    for _, child in ipairs(instance:GetDescendants()) do
        resetAttributesAndValues(child)
    end
end

wipeCooldowns(workspace)
workspace.DescendantAdded:Connect(function(obj)
    resetAttributesAndValues(obj)
end)

