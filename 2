local function getHRP()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getEquippedToolName()
	local char = LocalPlayer.Character
	if char then
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then return tool.Name end
	end
	local attr = LocalPlayer:GetAttribute("EquippedTool")
	if type(attr) == "string" and attr ~= "" then return attr end
	return nil
end

local function getCurrentEnchantName()
	local toolName = getEquippedToolName()
	if not toolName then return nil end
	
	local enchantBag = LocalPlayer:FindFirstChild("EnchantBag")
	if enchantBag then
		local item = enchantBag:FindFirstChild(toolName)
		if item and item:FindFirstChild("CurrentEnchant") then
			return item.CurrentEnchant.Value
		end
	end
	
	local attr = LocalPlayer:GetAttribute("CurrentEnchant_" .. toolName)
	if attr then return tostring(attr) end
	
	return nil
end

local function matchTargetEnchant(current, target)
	if not current or not target then return false end
	current = tostring(current):lower():gsub("%s+", "")
	target = tostring(target):lower():gsub("%s+", "")
	return current:find(target, 1, true) ~= nil
end

local function notify(title, msg)
	pcall(function()
		local MessageModule = require(ReplicatedStorage.Modules.MessageModule)
		MessageModule.Send(title .. ": " .. msg, Color3.fromRGB(0, 230, 160), 3)
	end)
end

local function smartTeleport(query)
	local hrp = getHRP()
	if not hrp then return end
	
	if query == "스폰" then
		local spawnObj = Workspace:FindFirstChildOfClass("SpawnLocation")
		if spawnObj then
			hrp.CFrame = spawnObj.CFrame + Vector3.new(0, 4, 0)
			notify("텔레포트", "스폰 위치로 이동했습니다.")
			return
		end
	end
	
	local q = query:lower()
	local candidates = {}
	
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") or v:IsA("Model") then
			local name = v.Name:lower()
			if name:find(q, 1, true) then
				table.insert(candidates, v)
			end
		end
	end
	
	for _, v in ipairs(candidates) do
		if v:IsA("BasePart") then
			hrp.CFrame = v.CFrame + Vector3.new(0, 4, 0)
			notify("텔레포트", query .. " (으)로 이동했습니다.")
			return
		elseif v:IsA("Model") then
			local primary = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)
			if primary then
				hrp.CFrame = primary.CFrame + Vector3.new(0, 4, 0)
				notify("텔레포트", query .. " (으)로 이동했습니다.")
				return
			end
		end
	end
	
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("ProximityPrompt") then
			local pName = v.Parent and v.Parent.Name:lower() or ""
			if pName:find(q, 1, true) and v.Parent:IsA("BasePart") then
				hrp.CFrame = v.Parent.CFrame + Vector3.new(0, 4, 0)
				notify("텔레포트", query .. " (으)로 이동했습니다.")
				return
			end
		end
	end
	
	notify("텔레포트 오류", query .. " 대상 위치를 맵에서 찾을 수 없습니다.")
end

