AutoTab:CreateSection("무기 오토")

local SelectedWeapon = ""
local AttackDelay = 0.1
local AutoAttackEnabled = false

AutoTab:CreateButton({
   Name = "현재 들고 있는 무기 등록",
   Callback = function()
      local character = LocalPlayer.Character
      if character then
         local tool = character:FindFirstChildOfClass("Tool")
         if tool then
            SelectedWeapon = tool.Name
            Rayfield:Notify({
               Title = "무기 등록 완료",
               Content = "등록된 무기: " .. SelectedWeapon,
               Duration = 2.5,
               Image = 4483362458,
            })
         else
            Rayfield:Notify({
               Title = "등록 실패",
               Content = "손에 무기를 들고 눌러주세요.",
               Duration = 2.5,
               Image = 4483362458,
            })
         end
      end
   end,
})

AutoTab:CreateInput({
   Name = "공격 속도 설정 (초)",
   PlaceholderText = "기본값: 0.1",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
      local num = tonumber(Text)
      if num and num > 0 then
         AttackDelay = num
      else
         AttackDelay = 0.1
      end
   end,
})

AutoTab:CreateToggle({
   Name = "무기 오토 시작",
   CurrentValue = false,
   Flag = "AutoAttackToggle",
   Callback = function(Value)
      AutoAttackEnabled = Value
      if AutoAttackEnabled then
         task.spawn(function()
            while AutoAttackEnabled do
               if SelectedWeapon ~= "" then
                  local args = {
                     "ToolClick",
                     SelectedWeapon,
                     1,
                     workspace:GetServerTimeNow()
                  }
                  CentralEvent:FireServer(unpack(args))
               end
               task.wait(AttackDelay)
            end
         end)
      end
   end,
})

