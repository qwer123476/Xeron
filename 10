PlayerTab:CreateSection("속도 및 점프")

local WalkSpeedEnabled = false
local WalkSpeedValue = 16
local DefaultWalkSpeed = 16

local JumpPowerEnabled = false
local JumpPowerValue = 50
local DefaultJumpPower = 50

-- 원본 값 저장 및 초기화
local function setupHumanoid(char)
   local hum = char:WaitForChild("Humanoid", 5)
   if hum then
      DefaultWalkSpeed = hum.WalkSpeed
      DefaultJumpPower = hum.JumpPower
      hum.UseJumpPower = true -- 점프파워 적용 필수 설정
   end
end

if LocalPlayer.Character then setupHumanoid(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupHumanoid)

PlayerTab:CreateToggle({
   Name = "플레이어 속도 활성화",
   CurrentValue = false,
   Flag = "WalkSpeedToggle",
   Callback = function(Value)
      WalkSpeedEnabled = Value
      local character = LocalPlayer.Character
      if character and character:FindFirstChildOfClass("Humanoid") then
         local hum = character:FindFirstChildOfClass("Humanoid")
         if not WalkSpeedEnabled then
            hum.WalkSpeed = DefaultWalkSpeed
            if character:FindFirstChild("HumanoidRootPart") then
               character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, character.HumanoidRootPart.AssemblyLinearVelocity.Y, 0)
            end
         end
      end
   end,
})

PlayerTab:CreateSlider({
   Name = "플레이어 속도",
   Range = {16, 200},
   Increment = 1,
   Suffix = "속도",
   CurrentValue = 16,
   Flag = "WalkSpeedSlider",
   Callback = function(Value)
      WalkSpeedValue = Value
   end,
})

PlayerTab:CreateToggle({
   Name = "점프파워 활성화",
   CurrentValue = false,
   Flag = "JumpPowerToggle",
   Callback = function(Value)
      JumpPowerEnabled = Value
      local character = LocalPlayer.Character
      if character and character:FindFirstChildOfClass("Humanoid") then
         local hum = character:FindFirstChildOfClass("Humanoid")
         hum.UseJumpPower = true
         if not JumpPowerEnabled then
            hum.JumpPower = DefaultJumpPower
         else
            hum.JumpPower = JumpPowerValue
         end
      end
   end,
})

PlayerTab:CreateSlider({
   Name = "점프파워",
   Range = {50, 300},
   Increment = 1,
   Suffix = "파워",
   CurrentValue = 50,
   Flag = "JumpPowerSlider",
   Callback = function(Value)
      JumpPowerValue = Value
      if JumpPowerEnabled then
         local character = LocalPlayer.Character
         if character and character:FindFirstChildOfClass("Humanoid") then
            character:FindFirstChildOfClass("Humanoid").JumpPower = JumpPowerValue
         end
      end
   end,
})

-- 메인 물리 루프 (관성 제어 & 카메라 이탈 방지)
RunService.PreRender:Connect(function()
   local character = LocalPlayer.Character
   if character and character:FindFirstChildOfClass("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
      local hum = character:FindFirstChildOfClass("Humanoid")
      local hrp = character.HumanoidRootPart
      
      hum.UseJumpPower = true

      -- 속도 물리 제어 (CFrame 대신 안전한 Velocity 제어로 카메라 이탈 방지)
      if WalkSpeedEnabled then
         if hum.MoveDirection.Magnitude > 0 then
            local moveVel = hum.MoveDirection * WalkSpeedValue
            hrp.AssemblyLinearVelocity = Vector3.new(moveVel.X, hrp.AssemblyLinearVelocity.Y, moveVel.Z)
         else
            -- 입력 없을 때 관성 완전 제거
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
         end
      end

      -- 점프파워 제어
      if JumpPowerEnabled then
         hum.JumpPower = JumpPowerValue
      end

      -- 착지 시 완전 정지 (미끄러짐 제로)
      if hum.MoveDirection.Magnitude == 0 and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
         hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
      end
   end
end)

