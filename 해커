--== 집 판정 삭제 시스템 ==--

local function RemovePlot(plotObject)
    if not plotObject then return end
    local success, err = pcall(function()
        plotObject:Destroy()
    end)
    if not success then
        pcall(function()
            for _, part in ipairs(plotObject:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                    part.CanCollide = false
                    part.Anchored = false
                end
            end
            if plotObject:IsA("BasePart") then
                plotObject.Transparency = 1
                plotObject.CanCollide = false
            end
        end)
    end
end

local function FindAllPlots()
    local plots = {}
    local plotNames = {"Plot", "House", "HousePlot", "PlotArea", "Land", "MyPlot", "Property", "PlayerPlot", "PlotMain"}
    for _, name in ipairs(plotNames) do
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name:find(name) or obj.Name:lower():find("plot") or obj.Name:lower():find("house") then
                table.insert(plots, obj)
            end
        end
    end
    -- Also check PlayerCharacterLocationDetector
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name == "PlayerCharacterLocationDetector" then
            table.insert(plots, obj)
        end
    end
    return plots
end

