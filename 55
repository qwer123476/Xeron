rs2.Heartbeat:Connect(function(dt)
    if MouseAtt and mouse then
        MouseAtt.WorldPosition = mouse.Hit.Position
    end

    if not State.OrbitEnabled or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local myRoot = plr.Character.HumanoidRootPart
    
    if State.IsSpinning then
        State.RotationOffset = State.RotationOffset + (State.OrbitSpeed * dt)
    end
    
    local lookPoint = nil
    if State.Target and State.Target.Character and State.Target.Character:FindFirstChild("HumanoidRootPart") then
        lookPoint = State.Target.Character.HumanoidRootPart.Position
    else
        lookPoint = mouse.Hit.Position
    end
    
    for i = #State.OrbitList, 1, -1 do
        local bomb = State.OrbitList[i]
        
        if bomb and bomb.Parent then
            local part = bomb:FindFirstChild("Thruster") or bomb:FindFirstChild("Body") or bomb:FindFirstChild("Main") or bomb:FindFirstChild("Wedge")
            
            if part then
                part.CanCollide = false 
                
                -- [CLEAN: Highlight removed, Tracer only]
                UpdateTracer(part, State.Target)
                
                local count = #State.OrbitList
                local angle = (i / count) * (math.pi * 2) + State.RotationOffset
                local offX = math.cos(angle) * State.OrbitRadius
                local offZ = math.sin(angle) * State.OrbitRadius
                
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                
                local bounce = math.sin(tick() * 2 + i) 
                local orbitPos = myRoot.CFrame * CFrame.new(offX, 5 + bounce, offZ)
                
                if lookPoint then
                    part.CFrame = CFrame.lookAt(orbitPos.Position, lookPoint) * CFrame.Angles(0, math.rad(-90), 0)
                else
                    part.CFrame = CFrame.new(orbitPos.Position) * CFrame.Angles(0, math.rad(-90), 0)
                end
            end
        else
            table.remove(State.OrbitList, i)
        end
    end
    
    StatusLabel.Text = "Orbit: " .. #State.OrbitList .. " | Spin: " .. (State.IsSpinning and "ON" or "OFF")
end)

