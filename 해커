local function KillPlayer(targetPlayer)
    if not targetPlayer or not IsAlive(targetPlayer) then return end
    local char, hrp, hum = GetCharacter(targetPlayer)

    -- Method 1: Ragdoll Remote
    if Remotes.RagdollRemote then
        pcall(function()
            Remotes.RagdollRemote:FireServer(targetPlayer.UserId)
            Remotes.RagdollRemote:FireServer(targetPlayer)
        end)
    end

    -- Method 2: Bomb explosion at their position
    if Remotes.BombEvents then
        for _, bomb in ipairs(Remotes.BombEvents:GetDescendants()) do
            if bomb:IsA("RemoteEvent") or bomb:IsA("RemoteFunction") then
                pcall(function()
                    bomb:FireServer({
                        Position = hrp.Position,
                        Player = targetPlayer,
                        Type = "FireworkMissile",
                    })
                end)
            end
        end
    end

    -- Method 3: Damage via Data Remote
    if Remotes.DataRemoteEvent then
        pcall(function()
            Remotes.DataRemoteEvent:FireServer("DamagePlayer", {
                Target = targetPlayer.UserId,
                Damage = 999999,
            })
            Remotes.DataRemoteEvent:FireServer("KillPlayer", targetPlayer.UserId)
            Remotes.DataRemoteEvent:FireServer("RemoveFromGame", targetPlayer.UserId)
        end)
    end

    -- Method 4: Set health to 0
    if hum then
        pcall(function()
            hum.Health = 0
        end)
    end

    -- Method 5: Explosion part
    local explosion = Instance.new("Explosion")
    explosion.BlastRadius = 50
    explosion.BlastPressure = math.huge
    explosion.DestroyJointRadiusPercent = 1
    explosion.Position = hrp.Position
    explosion.Parent = Workspace
end

local function KickPlayer(targetPlayer)
    if not targetPlayer then return end
    local char, hrp, hum = GetCharacter(targetPlayer)

    -- Method 1: Grab line manipulation to launch them
    if Remotes.CreateGrabLine and Remotes.SetNetworkOwner then
        pcall(function()
            Remotes.CreateGrabLine:FireServer(hrp)
            Remotes.SetNetworkOwner:FireServer(hrp, LP.UserId)
            if Remotes.ExtendGrabLine then
                for i = 1, 50 do
                    Remotes.ExtendGrabLine:FireServer(hrp, Vector3.new(99999, 99999, 99999))
                    task.wait()
                end
            end
            if Remotes.DestroyGrabLine then
                Remotes.DestroyGrabLine:FireServer()
            end
        end)
    end

    -- Method 2: Send them flying with body position
    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.Position = Vector3.new(0, -5000, 0)
    bp.Parent = hrp

    task.delay(0.5, function()
        bp:Destroy()
    end)

    -- Method 3: Fire remote kick attempts
    if Remotes.DataRemoteEvent then
        pcall(function()
            Remotes.DataRemoteEvent:FireServer("KickPlayer", targetPlayer.UserId)
            Remotes.DataRemoteEvent:FireServer("BanPlayer", targetPlayer.UserId)
            Remotes.DataRemoteEvent:FireServer("RemovePlayer", targetPlayer.UserId)
        end)
    end

    -- Method 4: Struggle + Ragdoll spam
    if Remotes.Struggle then
        for i = 1, 10 do
            pcall(function()
                Remotes.Struggle:FireServer(targetPlayer)
                Remotes.Struggle:FireServer(targetPlayer.UserId)
            end)
        end
    end
end

