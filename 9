-- 메인 루프: TP워크(관성 제어, 걷기 이모트 16 고정) & 점프파워 제어
RunService.RenderStepped:Connect(function(dt)
   local character = LocalPlayer.Character
   if character and character:FindFirstChildOfClass("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
      local hum = character:FindFirstChildOfClass("Humanoid")
      local hrp = character.HumanoidRootPart
      
      -- 속도 제어
      if WalkSpeedEnabled then
         hum.WalkSpeed = 16 -- 걷는 모션(이모트)만 16으로 완전 고정
         if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * WalkSpeedValue * dt)
         else
            -- 멈췄을 때 미끄러지는 관성 완전 제거
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
         end
      end

      -- 점프파워 제어
      if JumpPowerEnabled then
         hum.JumpPower = JumpPowerValue
      end

      -- 점프 미끄러짐/관성 완전 제거 (땅에 닿아있을 때 horizontal 관성 0)
      if hum:GetState() == Enum.HumanoidStateType.Landed or (hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude == 0) then
         hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
      end
   end
end)

