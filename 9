-- 플라이 (Fly) 기능 - Rayfield 토글 + 슬라이더 연동
--------------------------------------------------------------------------------
local FlyEnabled = false
local FlySpeed = 50
local BodyGyro = nil
local BodyVelocity = nil

PlayerTab:CreateToggle({
   Name = "플라이 (Fly)",
   CurrentValue = false,
   Flag = "FlyToggle",
   Callback = function(Value)
      FlyEnabled = Value
      local character = LocalPlayer.Character
      if not character then return end
      local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
      local hum = character:FindFirstChildOfClass("Humanoid")
      
      if FlyEnabled and root and hum then
         hum.PlatformStand = true

         BodyGyro = Instance.new("BodyGyro")
         BodyGyro.P = 9e4
         BodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
         BodyGyro.cframe = root.CFrame
         BodyGyro.Parent = root

         BodyVelocity = Instance.new("BodyVelocity")
         BodyVelocity.velocity = Vector3.zero
         BodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
         BodyVelocity.Parent = root

         task.spawn(function()
            while FlyEnabled and character and character.Parent and hum.Health > 0 do
               local camera = workspace.CurrentCamera
               local moveDir = hum.MoveDirection

               if moveDir.Magnitude > 0 then
                  BodyVelocity.velocity = camera.CFrame:VectorToWorldSpace(CFrame.new(
                     (userControls and userControls:GetMoveVector().X or 0),
                     0,
                     (userControls and userControls:GetMoveVector().Z or 0)
                  ).Position) * FlySpeed
                  
                  -- 키보드/모바일 카메라 방향 연동 비행
                  local camLook = camera.CFrame.LookVector
                  BodyVelocity.velocity = camera.CFrame.Rotation * Vector3.new(
                     hum.MoveDirection.X * FlySpeed,
                     0,
                     -hum.MoveDirection.Z * FlySpeed
                  )
                  
                  -- 직관적인 카메라 방향 비행 계산
                  local flyDir = Vector3.zero
                  if hum.MoveDirection.Magnitude > 0 then
                     flyDir = (camera.CFrame.Rotation * hum.MoveDirection).Unit * FlySpeed
                  end
                  BodyVelocity.velocity = flyDir
               else
                  BodyVelocity.velocity = Vector3.zero
               end
               
               BodyGyro.cframe = camera.CFrame
               RunService.RenderStepped:Wait()
            end

            -- 플라이 종료 시 정리
            if BodyGyro then BodyGyro:Destroy() BodyGyro = nil end
            if BodyVelocity then BodyVelocity:Destroy() BodyVelocity = nil end
            if hum then hum.PlatformStand = false end
            if root then root.AssemblyLinearVelocity = Vector3.zero end
         end)
      else
         if BodyGyro then BodyGyro:Destroy() BodyGyro = nil end
         if BodyVelocity then BodyVelocity:Destroy() BodyVelocity = nil end
         if hum then hum.PlatformStand = false end
         if root then root.AssemblyLinearVelocity = Vector3.zero end
      end
   end,
})

