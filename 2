GridScroll.Position = UDim2.new(0, 10, 0, 34)
GridScroll.BackgroundTransparency = 1
GridScroll.ScrollBarThickness = 4
GridScroll.ScrollBarImageColor3 = Color3.fromRGB(80, 120, 240)
GridScroll.Parent = SelectFrame

local UIGrid = Instance.new("UIGridLayout")
UIGrid.CellSize = UDim2.new(0, 100, 0, 32)
UIGrid.CellPadding = UDim2.new(0, 6, 0, 6)
UIGrid.SortOrder = Enum.SortOrder.LayoutOrder
UIGrid.Parent = GridScroll

local enchantBtns = {}
for i, enchantName in ipairs(AllEnchants) do
	local Btn = Instance.new("TextButton")
	Btn.Name = enchantName
	Btn.Size = UDim2.new(0, 100, 0, 32)
	Btn.BackgroundColor3 = (State.TargetEnchant == enchantName) and Color3.fromRGB(0, 180, 120) or Color3.fromRGB(38, 44, 64)
	Btn.Text = enchantName
	Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	Btn.TextSize = 11
	Btn.Font = Enum.Font.GothamBold
	Btn.Parent = GridScroll
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = Btn
	
	enchantBtns[enchantName] = Btn
	
	Btn.MouseButton1Click:Connect(function()
		State.TargetEnchant = enchantName
		SelectedTextLabel.Text = "선택된 목표 인챈트: [" .. State.TargetEnchant .. "]"
		for _, b in pairs(enchantBtns) do
			b.BackgroundColor3 = Color3.fromRGB(38, 44, 64)
		end
		Btn.BackgroundColor3 = Color3.fromRGB(0, 180, 120)
		notify("목표 인챈트 선택", "[" .. enchantName .. "] (으)로 선택되었습니다.")
	end)
end

