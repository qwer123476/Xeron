--------------------------------------------------------------------------------
-- 노클립 (NoClip) - 요청하신 전용 코드
--------------------------------------------------------------------------------
local plr = LocalPlayer
local noClipT = false
local noClipConnection = nil
local NO_CLIP_PARTS = {"Head", "Torso", "UpperTorso", "LowerTorso", "LeftArm", "RightArm", "LeftLeg", "RightLeg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}

local function restoreCollision(char)
    if char then
        for _, partName in ipairs(NO_CLIP_PARTS) do
            local part = char:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function updateNoClipF()
    local char = plr.Character
    if not char then return end

    if noClipConnection then
        noClipConnection:Disconnect()
        noClipConnection = nil
    end

    if not noClipT then
        restoreCollision(char)
        return
    end
    
    noClipConnection = RunService.Stepped:Connect(function()
        if not noClipT or not char or not char.Parent then
            if noClipConnection then
                noClipConnection:Disconnect()
                noClipConnection = nil
            end
            return
        end

        for _, partName in ipairs(NO_CLIP_PARTS) do
            local part = char:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

PlayerTab:CreateToggle({
   Name = "노클립",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
      noClipT = Value
      updateNoClipF()
   end,
})

plr.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    if noClipT then
        updateNoClipF()
    end
end)

if plr.Character then
    task.wait(1)
    if noClipT then
        updateNoClipF()
    end
end

