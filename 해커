RunService.Heartbeat:Connect(function()
    local char, hrp, hum = GetCharacter(LP)
    if not char or not hrp then return end

    -- Speed
    if Settings.Speed and hum then
        hum.WalkSpeed = Settings.SpeedValue
    elseif hum and hum.WalkSpeed ~= 16 then
        hum.WalkSpeed = 16
    end

    -- Jump Power
    if Settings.Jump and hum then
        hum.JumpPower = Settings.JumpPower
    elseif hum and hum.JumpPower ~= 50 then
        hum.JumpPower = 50
    end

    -- Fly
    if Settings.Fly then
        hrp.Velocity = Vector3.new(0, 0, 0)
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.Velocity = moveDir * Settings.FlySpeed
        end
        -- Space to go up, Shift to go down
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            hrp.Velocity = hrp.Velocity + Vector3.new(0, Settings.FlySpeed, 0)
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            hrp.Velocity = hrp.Velocity + Vector3.new(0, -Settings.FlySpeed, 0)
        end
    end

    -- Noclip
    if Settings.Noclip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

