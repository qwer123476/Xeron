--== 유틸리티 함수 ==--

local function GetCharacter(player)
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        return player.Character, player.Character:FindFirstChild("HumanoidRootPart"), player.Character:FindFirstChildOfClass("Humanoid")
    end
    return nil, nil, nil
end

local function GetPlayers(includeSelf)
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if (includeSelf or p ~= LP) and GetCharacter(p) then
            table.insert(list, p)
        end
    end
    return list
end

local function IsAlive(player)
    local char, hrp, hum = GetCharacter(player)
    return char and hrp and hum and hum.Health > 0
end

local function GetNetworkOwner(part)
    if not part then return nil end
    local ok, owner = pcall(function()
        return part:GetNetworkOwner()
    end)
    if ok then return owner end
    return nil
end

--== 콤보 시스템: 사일런트 에임 ==--

local SilentAimTargets = {}
local SilentAimThread = nil

local function UpdateSilentAimTargets()
    SilentAimTargets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and IsAlive(player) then
            local char, hrp = GetCharacter(player)
            local head = char:FindFirstChild("Head")
            if head then
                table.insert(SilentAimTargets, {
                    Player = player,
                    Position = head.Position,
                    Head = head,
                    HRP = hrp,
                    Distance = (Camera.CFrame.Position - head.Position).Magnitude,
                })
            end
        end
    end
    table.sort(SilentAimTargets, function(a, b)
        return a.Distance < b.Distance
    end)
end

local function GetSilentAimTarget()
    if not Settings.SilentAim then return nil end
    UpdateSilentAimTargets()

    local mousePos = UIS:GetMouseLocation()
    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local fov = Settings.SilentAimFOV

    local bestTarget = nil
    local bestDist = fov

    for _, target in ipairs(SilentAimTargets) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(target.Position)
        if onScreen then
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestTarget = target
            end
        end
    end

    return bestTarget
end

