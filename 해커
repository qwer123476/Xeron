local function SetOnFire(player)
    local char = player.Character
    if not char then return end

    local CatchFire = RS:FindFirstChild("CatchFire")
    local FirePlayerPart = CatchFire and CatchFire:FindFirstChild("FirePlayerPart")
    local FireDecor = CatchFire and CatchFire:FindFirstChild("FireDecor")

    if FirePlayerPart then
        local clone = FirePlayerPart:Clone()
        clone.Parent = char
        local canBurn = clone:FindFirstChild("CanBurn")
        if canBurn then canBurn.Value = true end

        -- Activate all particles and lights
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("ParticleEmitter") then
                v.Enabled = true
                v.Rate = 500
            end
            if v:IsA("PointLight") then
                v.Enabled = true
                v.Brightness = 10
            end
            if v:IsA("Sound") then
                pcall(function()
                    v:Play()
                    v.Looped = true
                    v.Volume = 10
                end)
            end
        end
    end
end

