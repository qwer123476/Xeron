local function TeleportTo(coordinate)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(coordinate)
    end
end

local function IsPvpActive(targetPlayer)
   if not targetPlayer or targetPlayer == LocalPlayer then return false end
   local char = targetPlayer.Character
   if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return false end
   if not char:FindFirstChild("HumanoidRootPart") then return false end

   local pvpState = targetPlayer:GetAttribute("PVP") or targetPlayer:GetAttribute("PvpState") or targetPlayer:GetAttribute("PVPState")
   if pvpState ~= nil then return pvpState == true end
   
   if char:GetAttribute("PVP") ~= nil or char:GetAttribute("PvpState") ~= nil then
      return (char:GetAttribute("PVP") == true) or (char:GetAttribute("PvpState") == true)
   end

   local folderPath = workspace:FindFirstChild("Players") or workspace:FindFirstChild("Characters")
   if folderPath then
      local targetFolder = folderPath:FindFirstChild(targetPlayer.Name)
      if targetFolder and (targetFolder:GetAttribute("PVP") == true or targetFolder:GetAttribute("PvpState") == true) then
         return true
      end
   end
   return false
end

