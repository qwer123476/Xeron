         Lighting.Brightness = BackupLighting.Brightness
         Lighting.FogEnd = BackupLighting.FogEnd
         Lighting.OutdoorAmbient = BackupLighting.OutdoorAmbient

         for _, conn in ipairs(Conns) do
            conn:Disconnect()
         end
         Conns = {}
      end
